# .env.example — Copy this to .env and fill in your keys
# NEVER commit the actual .env file to git (it contains secrets)

# Required for: LLM planning, evaluation, synthesis, and OpenAI embeddings
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Recommended for best search quality
# DuckDuckGo fallback is used automatically if this is absent
# Get your key at: https://app.tavily.com (free tier: 1000 searches/month)
TAVILY_API_KEY=tvly-your-tavily-key-here
